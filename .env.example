# Copy to .env and fill in. Never commit the real .env file.

# Postgres connection. Use the pooled URL on Neon/Vercel and the direct URL for migrations.
DATABASE_URL=postgresql://ifa:ifa@localhost:5432/ifaboru
DIRECT_URL=postgresql://ifa:ifa@localhost:5432/ifaboru

# Long random string. Required. Sessions are signed with this.
AUTH_SECRET=replace-with-a-long-random-string

# First admin password used only by `npm run seed`. At least 8 characters.
# Do not commit the real value.
SEED_ADMIN_PASSWORD=replace-with-a-long-admin-password

# local = school LAN server. cloud = Vercel/hosted.
DEPLOYMENT_MODE=local

# Set true behind HTTPS (Vercel does this automatically when VERCEL=1).
COOKIE_SECURE=false

# Show demo usernames on the login page. Turn off for a real school.
DEMO_HINTS=true

# Optional online sync. Same SYNC_TOKEN on the school server and the cloud site.
# SYNC_REMOTE_URL is set only on the offline server (the cloud site's public URL).
SYNC_REMOTE_URL=
SYNC_TOKEN=

# Public URL of this instance, used in README examples and backup notes.
APP_URL=http://localhost:43123
