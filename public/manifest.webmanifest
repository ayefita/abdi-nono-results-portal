{
  "id": "/",
  "name": "Abdi Nono Results",
  "short_name": "ANMPS",
  "description": "Student results for Abdi Nono Model Primary School.",
  "start_url": "/login",
  "scope": "/",
  "display": "standalone",
  "display_override": ["standalone", "browser"],
  "orientation": "any",
  "background_color": "#083c2b",
  "theme_color": "#083c2b",
  "lang": "en",
  "categories": ["education"],
  "icons": [
    { "src": "/icon-192.png", "sizes": "192x192", "type": "image/png", "purpose": "any" },
    { "src": "/icon-512.png", "sizes": "512x512", "type": "image/png", "purpose": "any" },
    { "src": "/icon-maskable-512.png", "sizes": "512x512", "type": "image/png", "purpose": "maskable" },
    { "src": "/logo.svg", "sizes": "any", "type": "image/svg+xml", "purpose": "any" }
  ],
  "shortcuts": [
    { "name": "My results", "url": "/student", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] },
    { "name": "Report card", "url": "/student/report", "icons": [{ "src": "/icon-192.png", "sizes": "192x192" }] }
  ]
}
